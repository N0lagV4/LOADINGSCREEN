CreditLabel.TextColor3 = Color3.fromRGB(245, 200, 66)
CreditLabel.TextSize = 13
CreditLabel.Font = Enum.Font.Code
CreditLabel.Parent = Card

-- Status messages that change as % increases
local statusMessages = {
    [0]  = "Securing environmental pipeline...",
    [18] = "Loading garden assets...",
    [36] = "Connecting to script engine...",
    [54] = "Initializing crop modules...",
    [72] = "Finalizing setup...",
}

local function getStatusMsg(p)
    local msg = "Securing environmental pipeline..."
    for threshold, text in pairs(statusMessages) do
        if p >= threshold then
            msg = text
        end
    end
    return msg
end

-- Slow countdown: 1% every 0.42 seconds, stops at 85% and stays forever
task.spawn(function()
    local pct = 0
    while pct < 80 do
        task.wait(0.42)
        pct = pct + 1
        local ratio = pct / 100
        TweenService:Create(BarFill, TweenInfo.new(0.4, Enum.EasingStyle.Linear), {
            Size = UDim2.new(ratio, 0, 1, 0)
        }):Play()
        PctLabel.Text = pct .. "%"
        StatusLabel.Text = getStatusMsg(pct)
    end
    -- Frozen at 85% forever — GUI stays open until player closes Roblox or resets
    StatusLabel.Text = "Waiting..."
    LoadingLabel.Text = "Loading..."
    PctLabel.Text = "80%"
end)

print("[ZINK SCRIPT] Loading screen active - YT : ZINK SCRIPT")
